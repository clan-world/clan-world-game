# ClanWorld env template.
# Do not commit .env. Copy to .env.local (gitignored) and fill values.
#
# Two sections:
#   - Server-only: read by Node/tsx processes (keeper, narrator, webhook). Never sent to browser.
#   - Browser (Vite): MUST be prefixed with VITE_ to be included in Vite bundles.
#     readEnv() in _env.ts tries both bare and VITE_-prefixed names so callers use
#     the same key regardless of runtime context.

# ============================================================
# Server-only (Node / tsx — NOT exposed to browser bundle)
# ============================================================

# --- Chain ---
CHAIN=base-sepolia
# Primary RPC: Alchemy Base Sepolia — replace <YOUR_ALCHEMY_KEY> with your key
RPC_URL_PRIMARY=https://base-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
# Fallback: public Base Sepolia endpoint
RPC_URL_FALLBACK=https://sepolia.base.org
CLAN_WORLD_CONTRACT_ADDRESS=
CLAN_WORLD_LENS_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Convex backend ---
CONVEX_URL=
CONVEX_DEPLOY_URL=
# Required for cockpit-mirror writes (elder peer whisper, bulletins, orch events, human steering).
# Must match the deployment-side value set via:
#   npx convex env set INDEXER_SECRET <value>
# Without it, RealConvexClient mutations log-and-return (best-effort no-op) and the cockpit feed stays empty.
INDEXER_SECRET=
JUPITER_API_KEY=

# --- Solana Devnet GOLD token / Android wallet txs ---
CLAN_WORLD_GOLD_RPC_URL=https://api.devnet.solana.com
CLAN_WORLD_GOLD_MINT=FPBZJfEgxdkKEeT8pZhLRPg1NzwhyWJRqPKpzRWZLSAF
CLAN_WORLD_GOLD_FAUCET_PROGRAM_ID=aMwXvN227YK14C8eFQzgyk9h7TfkMk1XQkekZXS6WWQ
CLAN_WORLD_GOLD_TREASURY_OWNER=5YqhQK4LfJmaaZQLqSEfcJc4ViUQHX15quVCXwNJDFnd
CLAN_WORLD_GOLD_TREASURY_ATA=4jQN1PfXQ2yfU75K4pMiY4Ue62yXknjKFJ7L9wukSRn8

# --- Tick + heartbeat ---
KEEPER_MODE=foundry-loop
HEARTBEAT_CALLER_ENABLED=false
# Opt-in local/demo fake Convex heartbeat. Leave unset/false for real-deal
# testing and production; v1.1 replaces this with a chain-reader indexer.
CLANWORLD_USE_FAKE_HEARTBEAT=false
# Preferred explicit HTTP actions base URL. If UNSET (commented out), the runner
# derives this from hosted Convex URLs by replacing `.convex.cloud` with
# `.convex.site`. Self-hosted Convex does NOT derive — docker-compose requires
# this to be set explicitly (fail-loud). Default points at the in-cluster
# convex-backend HTTP actions port; prod must override to the routed URL.
CONVEX_WEBHOOK_URL=http://convex-backend:3211
WEBHOOK_SHARED_SECRET=
# Optional heartbeat success marker path override; defaults to /tmp/last-heartbeat-success.
# HEARTBEAT_SUCCESS_FILE_OVERRIDE=

# ============================================================
# Browser (Vite) — MUST be VITE_-prefixed to reach the bundle
# ============================================================

# Adapter toggles (true => stub impl, false/unset => real impl)
VITE_CLAN_WORLD_USE_STUB_CHAIN=true
VITE_CLAN_WORLD_USE_STUB_CONVEX=true
VITE_CLAN_WORLD_USE_STUB_LLM=true

# Demo/dev mode is opt-in. Set to 'true' only when intentionally showing mock
# clans, bandits, walls, and canned travel. Leave unset or 'false' for real
# Convex/chain state.
VITE_CLANWORLD_DEMO_MODE=false

# Diamond address realm-discriminator for client-side caches. Mirrors the
# server-side `CLAN_WORLD_CONTRACT_ADDRESS` above and SHOULD be set to the
# SAME value. Used to scope `localStorage` snapshot caches per realm so that
# the full-game-reset runbook (docs/runbooks/full-game-reset.md) — which
# redeploys the diamond while reusing the same Convex URL — doesn't leak the
# old realm's cached state into the new realm for up to 1 hour after reset.
# Vercel: set this per-environment (preview/prod) so each deployment scopes
# its localStorage to its own realm.
VITE_CLAN_WORLD_CONTRACT_ADDRESS=

# --- dev-ui (apps/dev-ui) ---
# WalletConnect Cloud project ID — required to enable the WalletConnect
# connector in dev-ui. Get one at https://cloud.walletconnect.com. When unset,
# dev-ui skips the WC connector (injected wallets like MetaMask still work).
# WC project IDs aren't secrets, but DO NOT commit a shared fallback — each
# dev/deployment should use its own to keep quota attribution clean.
VITE_WALLETCONNECT_PROJECT_ID=

# Pre-populates the diamond address input on load in dev-ui. Defaults to
# `0x14392f8276c6234064395e74f0741e26f1613c1e` (current Base Sepolia diamond)
# if unset. Override per-environment to point dev-ui at a different deployment.
VITE_DEFAULT_DIAMOND=

# ============================================================
# Runner daemon (packages/runner) — Cycle A + Cycle B per Elder
# ============================================================

# Claude Code OAuth Token for Elders
# Run `claude setup-token` to get one.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-xxx

# Active elder slot when running single-elder CLI mode (1-4). Multi-elder
# runner ignores this and spawns instances for ELDER_IDS=[1,2,3,4].
ELDER_N=

# 12-word BIP-39 mnemonic for the Elder wallets. HD-derived per ELDER_INDEX.
# In .env.local only; never commit. Path: ~/.secrets/clanworld-elder-wallets.json
ELDER_MNEMONIC=

# Per-elder index into the HD derivation path (0-3 for Elders 1-4).
ELDER_INDEX=

# Per-elder clan-id mappings (used by FilePeerInbox + AxlPeerInbox routing).
# When set, inbox key = elder slot; when unset, sender clan id is used verbatim.
ELDER_1_CLAN_ID=
ELDER_2_CLAN_ID=
ELDER_3_CLAN_ID=
ELDER_4_CLAN_ID=

# 0G memory adapter — set OG_STORAGE_ENABLED to ANY non-empty value to enable
# 0G KV mode. This is a feature flag, NOT a credential. Real auth comes from
# ELDER_MNEMONIC-derived wallets. Empty/unset = falls back to FileMemoryStore.
OG_STORAGE_ENABLED=
OG_STREAM_ID=
OG_STREAM_ID_CLAN_1=
OG_STREAM_ID_CLAN_2=
OG_STREAM_ID_CLAN_3=
OG_STREAM_ID_CLAN_4=
OG_KV_CLIENT_URL=

# 0G iNFT identity plane. The iNFT lives on 0G and is linked to Base clans by
# convention only: tokenId == clanId. No cross-chain owner validation in demo.
ZERO_G_RPC_URL=https://evmrpc.0g.ai
OG_CHAIN_ID=16661
OG_INFT_ADDRESS=
OG_INFT_PRIVATE_KEY=
INFT_OWNER=
INFT_OWNER_PRIVATE_KEY=
INFT_NEW_OWNER=
INFT_TOKEN_ID=
INFT_METADATA_URI=
INFT_TRANSFER_URI=
VITE_ZERO_G_RPC_URL=https://evmrpc.0g.ai
VITE_OG_CHAIN_ID=16661
VITE_OG_INFT_ADDRESS=
VITE_OWNER_EDITOR_ENABLED=true

# AXL peer transport — set both AXL_API_KEY and AXL_NETWORK_ID to enable AXL
# mode (real peer messaging). Either empty/unset = falls back to FilePeerInbox.
AXL_API_KEY=
AXL_NETWORK_ID=
AXL_NODE_URL=
# Per-elder peer ID lookup table for AXL spoof-rejection — required when AXL
# is enabled. Each elder must have its own AXL peer ID configured.
AXL_PEER_ID_1=
AXL_PEER_ID_2=
AXL_PEER_ID_3=
AXL_PEER_ID_4=

# Runner timing knobs
RUNNER_POLL_INTERVAL_MS=2000
RUNNER_DELIVERY_TIMEOUT_MS=10000
RUNNER_SETTLE_WINDOW_SEC=10

# ============================================================
# Docker / Compose stack (Phase 1 dockerize — issue #344+)
# ============================================================
# These variables drive the docker-compose.yml stack. Copy to .env and fill
# values; .env is gitignored. Two compose profiles are supported:
#
#   docker compose --profile dev  config    # local iteration (anvil-fork)
#   docker compose --profile prod config    # VPS deploy (real Base Sepolia)
#
# Secret-bearing values (admin keys, HMAC secrets, per-elder bus keys) are
# materialized as files under agents/secrets/ by `make bootstrap-*` targets
# (Phase 1.12, issue #355). DO NOT put raw secret bytes in .env — the
# compose file references file paths via the `secrets:` block.

# --- Domain + Caddy host port ---
# Hostname suffix used by the host caddy snippet in host/caddy/clan-world-docker.caddy
# (added in Phase 1.5, issue #348). Default values bind the stack to
# app.clan-world.com via cloudflared.
CLAN_WORLD_DOMAIN=clan-world.com
TLD_APP_SUBDOMAIN=app
# Host port the docker caddy listens on; the host (system-level) caddy
# reverse-proxies app.${CLAN_WORLD_DOMAIN} -> 127.0.0.1:${CADDY_HOST_PORT}.
# Canonical allocation via .world/ports.yml (purpose: clan-world-docker-caddy,
# frontend prod sub-band). 58731 falls in 587xx slot's prod sub-band (10-39).
CADDY_HOST_PORT=58731

# --- Chain selection (REQUIRED — heartbeat preflight asserts this) ---
# CHAIN_NETWORK selects between the dev (anvil-fork) and prod (real RPC) RPC
# URLs below. The heartbeat container's entrypoint aborts if this is unset
# or unrecognized, and asserts the observed chain ID matches the profile
# (Finding 9 fix in docs/plans/dockerize-elder-infra-v1.md).
CHAIN_NETWORK=dev

# RPC URL selection per profile (no cross-env fallback — Finding 48 fix):
#   - dev:  DEV_RPC_URL points at the docker-internal anvil-fork container
#   - prod: PROD_RPC_URL reuses the existing RPC_URL_PRIMARY declared above
#     (line ~17) — DO NOT redeclare the Alchemy URL here. The heartbeat
#     container's entrypoint reads RPC_URL_PRIMARY when CHAIN_NETWORK=prod.
DEV_RPC_URL=http://anvil-fork:8545

# --- anvil-fork (dev profile only) ---
# Pin a specific fork block so dev iteration is deterministic. Read once
# against RPC_URL_PRIMARY (line ~17) via `cast block-number`; the anvil-fork
# container then reads RPC_URL_PRIMARY as the upstream for the fork seed.
FORK_BLOCK_NUMBER=0

# --- Self-hosted Convex ---
# Image pins. Use commit SHAs in prod (not :latest) — the v1 plan calls for
# CONVEX_BACKEND_TAG=<sha> + CONVEX_DASHBOARD_TAG=<sha> resolved at deploy
# time. Phase 1.4 (#347) wires up the bootstrap-convex-admin-key target.
CONVEX_BACKEND_TAG=latest
CONVEX_DASHBOARD_TAG=latest
# Dev profile publishes loopback ports through tiny proxy services so the host
# can run the Convex CLI and open the dashboard. Prod keeps Convex Docker-
# internal; expose it through Caddy/Access instead of these dev loopbacks.
CONVEX_BACKEND_HOST_PORT=3210
CONVEX_DASHBOARD_HOST_PORT=6791
# URL the self-hosted Convex backend is reachable at FROM THE HOST running
# `make deploy-convex`, `make backup-convex`, and `make import-convex-schema`.
# Convex treats origins as exact strings — keep the host portion (127.0.0.1)
# consistent across CONVEX_*_URL / *_ORIGIN dev defaults to avoid CORS or
# origin-mismatch errors between the CLI, browser, and dashboard. Derived
# from CONVEX_BACKEND_HOST_PORT so changing the host bind keeps these in sync.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:${CONVEX_BACKEND_HOST_PORT:-3210}
# Dev browser-reachable API origin advertised by the backend. Prod must set a
# routed browser-reachable URL; deploy-convex rejects localhost/internal prod values.
# Dev derives from CONVEX_BACKEND_HOST_PORT to stay aligned with the CLI URL.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:${CONVEX_BACKEND_HOST_PORT:-3210}
# HTTP actions origin advertised by the backend. Dev heartbeat uses the Docker
# internal origin; prod must set the routed value expected by callers.
CONVEX_SITE_ORIGIN=http://convex-backend:3211
# Browser-reachable deployment URL for the dashboard. Dev derives from
# CONVEX_BACKEND_HOST_PORT so changing the host bind also updates the dashboard
# URL. Prod must override to an admin-routed URL if the dashboard is enabled.
CONVEX_DASHBOARD_DEPLOYMENT_URL=http://127.0.0.1:${CONVEX_BACKEND_HOST_PORT:-3210}
# CLI version pin (Finding 11 fix). The deploy script aborts if
# `npx convex --version` does not match this.
CONVEX_CLI_PINNED_VERSION=1.39.1

# --- Indexer flags (set on Convex env via `convex env set`, not in .env) ---
# After first deploy, export CONVEX_SELF_HOSTED_URL and
# CONVEX_SELF_HOSTED_ADMIN_KEY, then run:
#   convex env set CLANWORLD_USE_REAL_INDEXER true
#   convex env set INDEXER_START_BLOCK <block-at-deploy>
#   convex env set INDEXER_SECRET <secret>
#   convex env set RPC_URL_PRIMARY <base-sepolia-rpc>
#   convex env set CLAN_WORLD_CONTRACT_ADDRESS <diamond>
#   convex env set CLAN_WORLD_LENS_ADDRESS <lens>
#   convex env set WEBHOOK_SHARED_SECRET <secret>
# Heartbeat webhook fan-out is controlled by the heartbeat container env:
#   CONVEX_WEBHOOK_URL=http://convex-backend:3211

# --- Secrets (DOCKER SECRETS — file references, not raw bytes) ---
# These are NOT direct env values. Each variable below names the FILE the
# Docker secret reads from. `make bootstrap-*` (Phase 1.12) generates the
# files at the canonical paths and symlinks them into agents/secrets/.
#
# Convex admin key for CLI/dashboard access. The backend generates/persists its
# root instance secret inside the convex_data volume; this file is derived from
# the running backend by `make bootstrap-convex-admin-key`.
CONVEX_SELF_HOSTED_ADMIN_KEY_FILE=agents/secrets/convex-admin.key
# HMAC shared secret for heartbeat -> Convex webhook. File path:
# /etc/clan-world/secrets/webhook-shared.key
# Generate via: make bootstrap-bus-secrets
WEBHOOK_SHARED_SECRET_FILE=agents/secrets/webhook-shared.key
# Operator secret for enqueueing commands into the Convex command-bus.
BUS_OPERATOR_SECRET_FILE=agents/secrets/bus-operator.key
# Per-elder secrets for claiming commands out of the bus (Finding 22 —
# per-elder, not shared, so a compromised elder can't impersonate peers).
BUS_ELDER_SECRET_FILE_1=agents/secrets/bus-elder-1.key
BUS_ELDER_SECRET_FILE_2=agents/secrets/bus-elder-2.key
BUS_ELDER_SECRET_FILE_3=agents/secrets/bus-elder-3.key
BUS_ELDER_SECRET_FILE_4=agents/secrets/bus-elder-4.key

# --- Elder fleet size ---
# v1 ships 4 elders. The compose file is structured to make 12-elder mode a
# configuration change (#357 tracks the parameterized scale-out smoke test).
ELDER_COUNT=4

# Per-elder Anthropic/Codex tokens (optional in dev — Elders typically use
# OAuth via `claude setup-token`). When set, these are passed to the elder-N
# containers and override the OAuth flow.
ELDER_1_ANTHROPIC_API_KEY=
ELDER_2_ANTHROPIC_API_KEY=
ELDER_3_ANTHROPIC_API_KEY=
ELDER_4_ANTHROPIC_API_KEY=
ELDER_1_CLAUDE_CODE_OAUTH_TOKEN=
ELDER_2_CLAUDE_CODE_OAUTH_TOKEN=
ELDER_3_CLAUDE_CODE_OAUTH_TOKEN=
ELDER_4_CLAUDE_CODE_OAUTH_TOKEN=

# Codex API tokens per elder — for elders that prefer Codex CLI flows.
ELDER_1_CODEX_API_KEY=
ELDER_2_CODEX_API_KEY=
ELDER_3_CODEX_API_KEY=
ELDER_4_CODEX_API_KEY=
