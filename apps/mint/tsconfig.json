{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "@types/react": ["./node_modules/@types/react"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
