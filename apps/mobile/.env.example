# apps/mobile env — copy to .env.local (gitignored).
#
# Expo only inlines variables prefixed with EXPO_PUBLIC_ into the JS bundle.

# Convex deployment URL. MUST match what demo.clan-world.com/cockpit reads
# from, otherwise Hearth and the WebView will show different ticks. Check
# the cockpit's bundled JS for the live value:
#
#   curl -sSL https://demo.clan-world.com/cockpit/ \
#     | grep -oE 'src="[^"]+\.js"' | head -1
#
# Then fetch that JS file and grep for `convex.cloud`. As of 2026-05-06 this
# is happy-otter-123.convex.cloud — NOT the valuable-kudu-985 dev deployment
# in the repo-root .env.local.
EXPO_PUBLIC_CONVEX_URL=https://happy-otter-123.convex.cloud

# Cockpit URL the Cockpit-tab WebView loads.
# Production: https://demo.clan-world.com/cockpit
# Local dev:  http://10.0.2.2:5173/cockpit (Pixel emulator → host loopback)
EXPO_PUBLIC_COCKPIT_URL=https://demo.clan-world.com/cockpit
