enable-pre-post-scripts=true
auto-install-peers=true

# Hoist all transitive deps to the workspace root so Metro (apps/mobile) can
# resolve them via its `../../node_modules` lookup. Required because pnpm's
# default symlink layout puts peer deps inside the .pnpm/ virtual store, which
# Metro's resolver does not traverse. This mimics npm's default flat hoist
# behaviour and is the documented pnpm+React-Native escape hatch.
# (See https://pnpm.io/faq for the rationale.)
public-hoist-pattern[]=*
